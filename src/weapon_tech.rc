#include <winver.h>
#include "wt_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    WT_VERSION_MAJOR, WT_VERSION_MINOR, WT_VERSION_PATCH, 0
PRODUCTVERSION WT_VERSION_MAJOR, WT_VERSION_MINOR, WT_VERSION_PATCH, 0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      VS_FF_PRERELEASE
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "weapon_tech: Black Ops III weapon feel"
            VALUE "FileVersion",      WT_VERSION_STRING
            VALUE "ProductName",      "weapon_tech"
            VALUE "ProductVersion",   WT_VERSION_STRING
            VALUE "OriginalFilename", "weapon_tech.dll"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
